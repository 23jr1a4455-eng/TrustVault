SECRET_KEY=<generate-a-random-secret>
DEBUG=1
DATABASE_URL=postgresql://<local-db-user>:<url-encoded-password>@localhost:5432/<local-db-name>
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Optional in local DEBUG mode; required in production (DEBUG=0), at least 32 characters.
AUDIT_HMAC_KEY=
# Needed only when running `python manage.py seed`.
SEED_PASSWORD=
